{
  "name": "fedd",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "start": "react-native start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint App.tsx src __tests__",
    "test": "jest --runInBand",
    "check": "npm run typecheck && npm run lint && npm test",
    "bundle:android": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output .build/index.android.bundle --assets-dest .build/assets",
    "apk:debug": "cd android && gradlew.bat assembleDebug -Pstandalone=true"
  },
  "dependencies": {
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-safe-area-context": "5.10.1",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@react-navigation/native": "7.5.0",
    "@react-navigation/native-stack": "7.20.0",
    "@react-navigation/bottom-tabs": "7.20.0",
    "react-native-screens": "4.29.0",
    "react-native-svg": "15.15.5",
    "lucide-react-native": "1.55.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "codegenConfig": {
    "name": "FeddPlatformSpec",
    "type": "modules",
    "jsSrcsDir": "src/platform/specs",
    "android": {
      "javaPackageName": "com.fedd.platform"
    }
  }
}